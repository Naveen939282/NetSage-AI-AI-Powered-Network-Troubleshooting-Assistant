# ---------------------------------------------------------------------------
# NetSage-AI configuration
# Copy this file to ".env" and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# AI provider backend. Options: "openai", "mock".
# If "openai" is set but no key is provided, the app automatically falls back
# to the mock/demo provider (DEMO MODE) so the app always runs.
AI_PROVIDER=mock

# OpenAI API key (only needed when AI_PROVIDER=openai)
AI_API_KEY=

# OpenAI model name
AI_MODEL=gpt-4o-mini

# Optional: override the temperature for the live provider
AI_TEMPERATURE=0.2

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
